generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model alertasingresostock {
  idalerta      Int            @id @default(autoincrement())
  idingreso     Int?
  mensaje       String         @db.VarChar(255)
  fechaalerta   DateTime?      @default(now()) @db.Timestamp(6)
  leida         Boolean?       @default(false)
  tipo          String?        @db.VarChar
  idproducto    Int?
  resuelta      Boolean?       @default(false)
  ingresosstock ingresosstock? @relation(fields: [idingreso], references: [idingreso], onDelete: NoAction, onUpdate: NoAction)
}

model carritovirtual {
  idcarrito  Int       @id @default(autoincrement())
  idcliente  Int
  idproducto Int
  cantidad   Int
  clientes   clientes  @relation(fields: [idcliente], references: [idcliente], onDelete: NoAction, onUpdate: NoAction)
  productos  productos @relation(fields: [idproducto], references: [idproducto], onDelete: NoAction, onUpdate: NoAction)
}

model choferes {
  idchofer          Int               @id @default(autoincrement())
  nombre            String            @db.VarChar(100)
  apellido          String            @db.VarChar(100)
  dni               String            @unique @db.VarChar(20)
  telefono          String?           @db.VarChar(50)
  email             String?           @db.VarChar(100)
  licenciaconducir  String            @db.VarChar(50)
  fechavenclicencia DateTime          @db.Timestamp(6)
  estado            String?           @default("Activo") @db.VarChar(50)
  activo            Boolean?          @default(true)
  asignacionenvio   asignacionenvio[]
}

model Usuario {
  idusuario    Int         @id @default(autoincrement())
  email        String      @unique @db.VarChar(100)
  passwordhash String      @db.VarChar(256)
  tipousuario  TipoUsuario
  activo       Boolean     @default(true)
  fechaalta    DateTime    @default(now()) @db.Timestamp(6)
  updatedat    DateTime    @default(now()) @updatedAt @db.Timestamp(6)
  cliente      clientes?

  @@map("usuarios")
}

model clientes {
  idcliente      Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  apellido       String           @db.VarChar(100)
  email          String           @unique @db.VarChar(100)
  telefono       String?          @db.VarChar(20)
  direccion      String?          @db.VarChar(255)
  activo         Boolean?         @default(true)
  idusuario      Int?             @unique
  carritovirtual carritovirtual[]
  usuario        Usuario?         @relation(fields: [idusuario], references: [idusuario], onDelete: NoAction, onUpdate: NoAction)
  cupones        cupones[]
  puntoscliente  puntoscliente[]
  ventas         ventas[]
}

model cupones {
  idcupon             Int          @id @default(autoincrement())
  codigo              String       @unique @db.VarChar(20)
  descuentoporcentaje Int
  activo              Boolean?     @default(true)
  idpromocion         Int?
  idcliente           Int?
  fechavencimiento    DateTime?    @db.Timestamp(6)
  clientes            clientes?    @relation(fields: [idcliente], references: [idcliente], onDelete: NoAction, onUpdate: NoAction)
  promociones         promociones? @relation(fields: [idpromocion], references: [idpromocion], onDelete: NoAction, onUpdate: NoAction)
  usocupones          usocupones[]
}

model detalleingresostock {
  iddetalleingreso Int           @id @default(autoincrement())
  idingreso        Int
  idproducto       Int
  cantidad         Int
  ingresosstock    ingresosstock @relation(fields: [idingreso], references: [idingreso], onDelete: NoAction, onUpdate: NoAction)
  productos        productos     @relation(fields: [idproducto], references: [idproducto], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalleordencompra {
  iddetalleoc    Int           @id @default(autoincrement())
  idorden        Int
  idproducto     Int
  cantidad       Int
  preciounitario Decimal       @db.Decimal(18, 2)
  subtotal       Decimal       @db.Decimal(18, 2)
  ordenescompra  ordenescompra @relation(fields: [idorden], references: [idorden], onDelete: NoAction, onUpdate: NoAction)
  productos      productos     @relation(fields: [idproducto], references: [idproducto], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detallepromocion {
  iddetalle           Int         @id @default(autoincrement())
  idpromocion         Int
  idproducto          Int?
  descuentoporcentaje Int
  productos           productos?  @relation(fields: [idproducto], references: [idproducto], onDelete: NoAction, onUpdate: NoAction)
  promociones         promociones @relation(fields: [idpromocion], references: [idpromocion], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idpromocion, idproducto], map: "uq_detallepromocion")
}

model detalleventas {
  iddetalle      Int       @id @default(autoincrement())
  idventa        Int
  idproducto     Int
  cantidad       Int
  preciounitario Decimal   @db.Decimal(18, 2)
  productos      productos @relation(fields: [idproducto], references: [idproducto], onDelete: NoAction, onUpdate: NoAction)
  ventas         ventas    @relation(fields: [idventa], references: [idventa], onDelete: NoAction, onUpdate: NoAction)
}

model envios {
  idenvio            Int              @id @default(autoincrement())
  idventa            Int
  direccionentrega   String           @db.VarChar(200)
  fechaenvio         DateTime?        @default(now()) @db.Timestamp(6)
  estado             String?          @default("Generado") @db.VarChar(50)
  observaciones      String?          @db.VarChar(255)
  comprobanteentrega String?          @db.VarChar(255)
  activo             Boolean?         @default(true)
  asignacionenvio    asignacionenvio?
  detalleenvio       detalleenvio[]
  ventas             ventas           @relation(fields: [idventa], references: [idventa], onDelete: NoAction, onUpdate: NoAction)
  trackingenvio      trackingenvio[]
}

model ingresosstock {
  idingreso           Int                   @id @default(autoincrement())
  idorden             Int?
  fechaingreso        DateTime?             @default(now()) @db.Timestamp(6)
  observaciones       String?               @db.VarChar(255)
  alertasingresostock alertasingresostock[]
  detalleingresostock detalleingresostock[]
  ordenescompra       ordenescompra?        @relation(fields: [idorden], references: [idorden], onDelete: NoAction, onUpdate: NoAction)
}

model notificacioneslogistica {
  idnotificacion     Int       @id @default(autoincrement())
  idventa            Int
  fechaenvio         DateTime? @default(now()) @db.Timestamp(6)
  estadonotificacion String?   @default("Pendiente") @db.VarChar(20)
  ventas             ventas    @relation(fields: [idventa], references: [idventa], onDelete: NoAction, onUpdate: NoAction)
}

model ordenescompra {
  idorden            Int                  @id @default(autoincrement())
  idproveedor        Int
  fechapedido        DateTime?            @default(now()) @db.Timestamp(6)
  estado             String?              @default("Generada") @db.VarChar(50)
  observaciones      String?              @db.VarChar(255)
  total              Decimal?             @default(0) @db.Decimal(18, 2)
  detalleordencompra detalleordencompra[]
  ingresosstock      ingresosstock[]
  proveedores        proveedores          @relation(fields: [idproveedor], references: [idproveedor], onDelete: NoAction, onUpdate: NoAction)
}

model productos {
  idproducto          Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(100)
  precio              Decimal               @db.Decimal(18, 2)
  stockactual         Int?                  @default(0)
  puntoreposicion     Int?                  @default(5)
  carritovirtual      carritovirtual[]
  detalleenvio        detalleenvio[]
  detalleingresostock detalleingresostock[]
  detalleordencompra  detalleordencompra[]
  detallepromocion    detallepromocion[]
  detalleventas       detalleventas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model promociones {
  idpromocion      Int                @id @default(autoincrement())
  nombre           String             @db.VarChar(100)
  descripcion      String?            @db.VarChar(255)
  fechadesde       DateTime           @db.Timestamp(6)
  fechahasta       DateTime           @db.Timestamp(6)
  activa           Boolean?           @default(true)
  eliminada        Boolean            @default(false)
  esGeneral        Boolean            @default(false)
  updatedat        DateTime?          @default(now()) @db.Timestamp(6)
  cupones          cupones[]
  detallepromocion detallepromocion[]
}

model proveedores {
  idproveedor   Int             @id @default(autoincrement())
  razonsocial   String          @db.VarChar(150)
  cuit          String          @unique @db.VarChar(20)
  email         String          @db.VarChar(100)
  telefono      String?         @db.VarChar(50)
  direccion     String?         @db.VarChar(150)
  activo        Boolean?        @default(true)
  ordenescompra ordenescompra[]
}

model puntoscliente {
  idpunto         Int       @id @default(autoincrement())
  idcliente       Int
  idventa         Int?
  puntosotorgados Int
  fecha           DateTime? @default(now()) @db.Timestamp(6)
  concepto        String    @db.VarChar(100)
  clientes        clientes  @relation(fields: [idcliente], references: [idcliente], onDelete: NoAction, onUpdate: NoAction)
  ventas          ventas?   @relation(fields: [idventa], references: [idventa], onDelete: NoAction, onUpdate: NoAction)
}

model rutas {
  idruta          Int               @id @default(autoincrement())
  nombreruta      String            @db.VarChar(100)
  zona            String            @db.VarChar(100)
  fecharuta       DateTime          @db.Timestamp(6)
  estado          String?           @default("Pendiente") @db.VarChar(50)
  observaciones   String?           @db.VarChar(255)
  activo          Boolean?          @default(true)
  asignacionenvio asignacionenvio[]
}

model usocupones {
  iduso   Int     @id @default(autoincrement())
  idcupon Int
  idventa Int
  cupones cupones @relation(fields: [idcupon], references: [idcupon], onDelete: NoAction, onUpdate: NoAction)
  ventas  ventas  @relation(fields: [idventa], references: [idventa], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehiculos {
  idvehiculo      Int               @id @default(autoincrement())
  patente         String            @unique @db.VarChar(20)
  marca           String            @db.VarChar(100)
  modelo          String            @db.VarChar(100)
  anio            Int
  capacidadcarga  Decimal?          @db.Decimal(10, 2)
  estado          String?           @default("Disponible") @db.VarChar(50)
  activo          Boolean?          @default(true)
  asignacionenvio asignacionenvio[]
}

model ventas {
  idventa                 Int                       @id @default(autoincrement())
  idcliente               Int
  fechaventa              DateTime?                 @default(now()) @db.Timestamp(6)
  subtotal                Decimal                   @db.Decimal(18, 2)
  descuento               Decimal?                  @default(0) @db.Decimal(18, 2)
  total                   Decimal                   @db.Decimal(18, 2)
  estado                  estadoventa               @default(Confirmada)
  direccionentrega        String?                   @db.VarChar(200)
  indicacionesentrega     String?                   @db.VarChar(200)
  detalleventas           detalleventas[]
  envios                  envios[]
  notificacioneslogistica notificacioneslogistica[]
  puntoscliente           puntoscliente[]
  usocupones              usocupones[]
  clientes                clientes                  @relation(fields: [idcliente], references: [idcliente], onDelete: NoAction, onUpdate: NoAction)
}

model asignacionenvio {
  idasignacion    Int       @id @default(autoincrement())
  idenvio         Int       @unique
  idvehiculo      Int
  idchofer        Int
  idruta          Int
  fechaasignacion DateTime? @default(now()) @db.Timestamp(6)
  choferes        choferes  @relation(fields: [idchofer], references: [idchofer], onDelete: NoAction, onUpdate: NoAction, map: "fk_asig_chofer")
  envios          envios    @relation(fields: [idenvio], references: [idenvio], onDelete: NoAction, onUpdate: NoAction, map: "fk_asig_envio")
  rutas           rutas     @relation(fields: [idruta], references: [idruta], onDelete: NoAction, onUpdate: NoAction, map: "fk_asig_ruta")
  vehiculos       vehiculos @relation(fields: [idvehiculo], references: [idvehiculo], onDelete: NoAction, onUpdate: NoAction, map: "fk_asig_vehiculo")
}

model detalleenvio {
  iddetalleenvio Int       @id @default(autoincrement())
  idenvio        Int
  idproducto     Int
  cantidad       Int
  envios         envios    @relation(fields: [idenvio], references: [idenvio], onDelete: NoAction, onUpdate: NoAction, map: "fk_detenv_envio")
  productos      productos @relation(fields: [idproducto], references: [idproducto], onDelete: NoAction, onUpdate: NoAction, map: "fk_detenv_producto")
}

model trackingenvio {
  idtracking     Int       @id @default(autoincrement())
  idenvio        Int
  estadoanterior String?   @db.VarChar(50)
  estadonuevo    String    @db.VarChar(50)
  fechacambio    DateTime? @default(now()) @db.Timestamp(6)
  observaciones  String?   @db.VarChar(255)
  envios         envios    @relation(fields: [idenvio], references: [idenvio], onDelete: NoAction, onUpdate: NoAction, map: "fk_track_envio")
}

enum TipoUsuario {
  SISTEMA
  CLIENTE
}

enum estadoventa {
  Confirmada
  Completada
  Cancelada  @map("Cancelada")
}
